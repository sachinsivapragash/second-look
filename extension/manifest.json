{
  "manifest_version": 3,
  "name": "Second Look: is this a scam?",
  "version": "0.2.0",
  "description": "Live scam warnings in Gmail and WhatsApp Web, plus right-click checks anywhere. Instant checks run locally in your browser; nothing is sent unless you ask for a full check.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Second Look"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "dist/guard.js"
      ],
      "run_at": "document_idle"
    }
  ]
}